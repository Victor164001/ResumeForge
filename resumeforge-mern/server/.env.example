# Copy to .env and fill in
PORT=5000
NODE_ENV=development

# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/resumeforge

# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React app runs in development (for CORS)
CLIENT_URL=http://localhost:5173
